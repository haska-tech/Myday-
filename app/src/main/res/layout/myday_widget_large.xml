<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/myday_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="MyDay" android:fontFamily="sans"
            android:textColor="#14233B" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="6dp" android:text="+ Add"
            android:textColor="#4C8C24" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="6dp" android:text="↻"
            android:textColor="#638C22" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="5dp" android:text="Today"
        android:textColor="#748094" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_progress_label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0/0 done" android:textColor="#638C22"
            android:textSize="10sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/widget_progress_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1"
            android:layout_marginStart="9dp" android:progress="0" android:max="100"
            android:progressTint="#B7E445" android:progressBackgroundTint="#E3E8EF" />
    </LinearLayout>
    <TextView android:id="@+id/widget_priorities" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:text="TOP PRIORITIES" android:textColor="#4C8C24" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/widget_task_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_tasks" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="top" android:maxLines="8"
            android:ellipsize="end" android:text="Your tasks appear here."
            android:textColor="#14233B" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="7dp" android:text="OPEN MYDAY  ·  PLAN WITH PURPOSE"
        android:textColor="#687386" android:textSize="10sp" />
</LinearLayout>