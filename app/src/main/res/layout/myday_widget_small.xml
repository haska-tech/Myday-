<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="7dp" android:background="@drawable/myday_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="MyDay" android:fontFamily="sans" android:textColor="#14233B"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="4dp" android:paddingEnd="2dp" android:text="+ Add" android:textColor="#4C8C24"
            android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Today" android:textColor="#748094" android:textSize="9sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="12dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_progress_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0/0 done" android:textColor="#638C22" android:textSize="8sp" />
        <ProgressBar android:id="@+id/widget_progress_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"
            android:layout_marginStart="5dp" android:progress="0" android:max="100"
            android:progressTint="#B7E445" android:progressBackgroundTint="#E3E8EF" />
    </LinearLayout>
    <TextView android:id="@+id/widget_priorities" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="2dp" android:text="TOP PRIORITIES" android:textColor="#638C22"
        android:textSize="8sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/widget_task_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_tasks" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="top" android:maxLines="2"
            android:ellipsize="end" android:text="Your tasks appear here."
            android:textColor="#14233B" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="↻" android:textColor="#4C8C24"
            android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_footer" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end"
            android:text="OPEN MYDAY" android:textSize="8sp" android:textColor="#687386" />
    </LinearLayout>
</LinearLayout>